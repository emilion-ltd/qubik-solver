PORT=3000
# public URL of this server — SmartPay redirects the customer back here and POSTs the IPN here.
# for local testing keep localhost; in production set your real https domain.
PUBLIC_BASE_URL=http://localhost:3000
# random long secret used to sign unlock tokens
UNLOCK_SECRET=change-me-to-a-long-random-string
# SmartPay (Star Networks) — from the SmartPay dashboard / account manager.
# sandbox: https://devapi.smartpay.co.il/v1 (default)   production: https://api.protected-payment.com/v1
SMARTPAY_API_URL=https://devapi.smartpay.co.il/v1
SMARTPAY_CUID=
SMARTPAY_SECRET_KEY=
SMARTPAY_PAGE_UUID=
# prices in ILS (must match CONFIG.prices in index.html)
PRICE_SINGLE=7.90
PRICE_UNLIMITED=24.90
